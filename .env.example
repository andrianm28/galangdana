# Postgres
DATABASE_URL=postgres://fundforindonesia:fundforindonesia@localhost:55434/fundforindonesia

# Container credentials, interpolated into docker-compose.yml. Required --
# docker-compose.yml uses ${VAR:?} so `docker compose up` fails loudly rather
# than silently starting with a committed default. This repo is public; the
# previous literals (POSTGRES_PASSWORD: galangdana, MINIO_ROOT_PASSWORD:
# galangdana-dev-secret, MEILI_MASTER_KEY: galangdana-dev-master-key) were
# readable by anyone, which is the same "fail closed rather than ship a
# committed default" reasoning already applied to MOCK_MIDTRANS_SERVER_KEY and
# SUMOPOD_WEBHOOK_SECRET below. For local dev generate your own, e.g.:
#   POSTGRES_PASSWORD="$(openssl rand -hex 24)"
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
MEILI_MASTER_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
# Must match MEILI_MASTER_KEY above (docker-compose.yml reads it from there).
MEILISEARCH_API_KEY=

# Mailpit (SMTP dev)
SMTP_HOST=localhost
SMTP_PORT=1025

# API
API_PORT=3001
PUBLIC_API_URL=http://localhost:3001

# Mock payment provider (bank_transfer_va) -- this is a stand-in for a real
# Midtrans-shaped integration, not a real payment provider. Required: without
# it, both creating a bank_transfer_va donation and the /payments/webhook
# endpoint hard-fail rather than falling back to an insecure default (a
# committed default here was a real, exploitable vulnerability -- anyone
# reading the source could forge a signed "paid" webhook). For local
# dev/test, generate your own value rather than sharing one -- any string
# works, e.g.:
#   MOCK_MIDTRANS_SERVER_KEY="$(openssl rand -hex 32)"
MOCK_MIDTRANS_SERVER_KEY=

# Google OAuth (dev/local — get real values from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Web app URL (used as the post-login redirect target)
PUBLIC_WEB_URL=http://localhost:5173

# Sumopod (QRIS payment provider) -- get real values from the Sumopod
# dashboard for production. SUMOPOD_WEBHOOK_SECRET is required: without
# it, both creating a QRIS donation and the /payments/webhook/sumopod
# endpoint hard-fail rather than falling back to an insecure default.
# For local dev/test, generate your own value rather than sharing one --
# any string in the form "whsec_<base64>" works, e.g.:
#   SUMOPOD_WEBHOOK_SECRET="whsec_$(openssl rand -base64 32)"
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=

# Media pipeline (imgproxy + MinIO) -- Phase 1
IMGPROXY_KEY=4ac5d314cc578f0216d080c03b2bc517a7e4226af8a4ed6a5617cf94e44c554c
IMGPROXY_SALT=00325181fcb6c7a7ef94ba22eab86f3115ddfaf7178dcba96d19a327c0ab65f1
IMGPROXY_BASE_URL=http://localhost:8090
MEDIA_SOURCE_BASE_URL=http://localhost:9000/campaign-media
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY_ID=fundforindonesia
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_BUCKET=campaign-media
MEDIA_S3_PRIVATE_BUCKET=campaign-documents
