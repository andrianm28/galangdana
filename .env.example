# Postgres
DATABASE_URL=postgres://galangdana:galangdana@localhost:55434/galangdana

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=galangdana
S3_SECRET_KEY=galangdana-dev-secret
S3_BUCKET_MEDIA=galangdana-media

# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=galangdana-dev-master-key

# Mailpit (SMTP dev)
SMTP_HOST=localhost
SMTP_PORT=1025

# API
API_PORT=3001
PUBLIC_API_URL=http://localhost:3001

# Google OAuth (dev/local — get real values from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Web app URL (used as the post-login redirect target)
PUBLIC_WEB_URL=http://localhost:5173

# Sumopod (QRIS payment provider) -- get real values from the Sumopod
# dashboard for production. SUMOPOD_WEBHOOK_SECRET is required: without
# it, both creating a QRIS donation and the /payments/webhook/sumopod
# endpoint hard-fail rather than falling back to an insecure default. The
# placeholder below is the same test-only value used throughout
# packages/payments's own Sumopod tests, so local dev/test setup works
# out of the box via `cp .env.example .env`.
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=whsec_dGVzdC1zZWNyZXQta2V5LWZvci11bml0LXRlc3Rz

