# Postgres
DATABASE_URL=postgres://fundforindonesia:fundforindonesia@localhost:55434/fundforindonesia

# Container credentials, interpolated into docker-compose.yml. Required --
# docker-compose.yml uses ${VAR:?} so `docker compose up` fails loudly rather
# than silently starting with a committed default. This repo is public; the
# previous literals (POSTGRES_PASSWORD: galangdana, MINIO_ROOT_PASSWORD:
# galangdana-dev-secret, MEILI_MASTER_KEY: galangdana-dev-master-key) were
# readable by anyone, which is the same "fail closed rather than ship a
# committed default" reasoning already applied to MOCK_MIDTRANS_SERVER_KEY and
# SUMOPOD_WEBHOOK_SECRET below. For local dev generate your own, e.g.:
#   POSTGRES_PASSWORD="$(openssl rand -hex 24)"
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
MEILI_MASTER_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
# Must match MEILI_MASTER_KEY above (docker-compose.yml reads it from there).
MEILISEARCH_API_KEY=

# Mailpit (SMTP dev)
SMTP_HOST=localhost
SMTP_PORT=1025
# Production SMTP (Sumopod: host smtp.sumopod.com, port 465, SSL). The worker
# (apps/worker) uses implicit TLS exactly when the port is 465. Dev needs
# neither user nor pass (Mailpit takes anything); production sets both plus
# the envelope sender below.
#SMTP_USER=
#SMTP_PASS=
SMTP_FROM=donasi@fundforindonesia.org

# Error tracking (GlitchTip, Sentry-protocol, self-hosted in compose).
# Unset = SDK never initializes; the API behaves exactly as before (console
# logging only, including the per-request JSON access log, which is always
# on). Set to the `api` project DSN with the container host:port the API
# process itself can reach (NOT GlitchTip's internal default).
#SENTRY_DSN=http://<key>@127.0.0.1:8080/1

# kirim.dev WhatsApp (receipts). No dev values: without KIRIMDEV_API_KEY the
# worker leaves whatsapp rows pending with a config-missing error rather
# than marking them sent (fail-closed, like the payment providers).
#KIRIMDEV_API_KEY=
#KIRIMDEV_SENDER_ID=
# The Meta-approved template sent as the receipt. Create it in the kirim.dev
# dashboard (name + Indonesian language + amount/campaign/link body params)
# before the first real send; the default below is only a name, not the
# template itself.
#KIRIMDEV_TEMPLATE=donation_receipt
#KIRIMDEV_LANGUAGE=id

# Notification worker loop (apps/worker). Single poll interval and a
# per-row attempt cap with exponential backoff (1m, 2m, 4m ... max 1h);
# past the cap the row is marked failed, never silently dropped.
WORKER_POLL_INTERVAL_MS=15000
WORKER_MAX_ATTEMPTS=5

# API
API_PORT=3001
PUBLIC_API_URL=http://localhost:3001

# Mock payment provider (bank_transfer_va) -- this is a stand-in for a real
# Midtrans-shaped integration, not a real payment provider. Required: without
# it, both creating a bank_transfer_va donation and the /payments/webhook
# endpoint hard-fail rather than falling back to an insecure default (a
# committed default here was a real, exploitable vulnerability -- anyone
# reading the source could forge a signed "paid" webhook). For local
# dev/test, generate your own value rather than sharing one -- any string
# works, e.g.:
#   MOCK_MIDTRANS_SERVER_KEY="$(openssl rand -hex 32)"
MOCK_MIDTRANS_SERVER_KEY=

# Google OAuth (dev/local — get real values from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Web app URL (used as the post-login redirect target)
PUBLIC_WEB_URL=http://localhost:5173

# Sumopod (QRIS payment provider) -- get real values from the Sumopod
# dashboard for production. SUMOPOD_WEBHOOK_SECRET is required: without
# it, both creating a QRIS donation and the /payments/webhook/sumopod
# endpoint hard-fail rather than falling back to an insecure default.
# For local dev/test, generate your own value rather than sharing one --
# any string in the form "whsec_<base64>" works, e.g.:
#   SUMOPOD_WEBHOOK_SECRET="whsec_$(openssl rand -base64 32)"
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=
# Which Sumopod API host to create QRIS charges against. REQUIRED for QRIS:
# with it unset, availablePaymentMethods() leaves QRIS off the menu entirely.
# It is not defaulted, on purpose. A default meant a forgotten variable in
# production would charge the SANDBOX and nothing would error -- the donor
# pays nothing real, the sandbox webhook verifies, the donation is marked
# paid, and collectedAmount goes up. Every environment says which Sumopod it
# is charging, in writing.
SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com
#
# Production cutover runbook (QRIS-only; the mock VA is retired by deleting
# MOCK_MIDTRANS_SERVER_KEY from .env.production in the same step):
#   1. Deploy this code, then set the webhook URL in the Sumopod dashboard
#      to https://api.fundforindonesia.org/payments/webhook/sumopod and save.
#   2. Press "Save & Test": the dashboard ping (payment.test) must be
#      answered 200 {status:"ignored"} -- this verifies the webhook path
#      with no real money. Check the API logs, not just the dashboard.
#   3. Copy the generated signing secret into .env.production as
#      SUMOPOD_WEBHOOK_SECRET, and set SUMOPOD_BASE_URL to the PRODUCTION
#      host (not the sandbox one above). QRIS stays off the menu until
#      all three of SECRET, API_KEY and BASE_URL are set, so a half-done
#      cutover is invisible to donors rather than broken for them.
#   4. Restart fundforindonesia-api.service (env is read at process start).
#   5. Confirm GET /payment-methods returns only ["qris_redirect"].
#
# NOTE (verified 2026-09-06 against the real sandbox): Sumopod validates
# success/cancel return URLs server-side and rejects non-public hosts --
# a charge created with a localhost return URL fails with INVALID_REQUEST.
# SUMOPOD_RETURN_BASE_URL is that public origin. It defaults to
# PUBLIC_WEB_URL, so production (already https) needs no extra setting;
# local dev, whose PUBLIC_WEB_URL is localhost by design (CORS + login
# redirects must stay localhost), sets it explicitly below. Do not "fix"
# this by special-casing localhost in code. Uncomment and point at a public
# https origin when PUBLIC_WEB_URL is localhost:
#SUMOPOD_RETURN_BASE_URL=https://fundforindonesia.org

# Media pipeline (imgproxy + MinIO) -- Phase 1
IMGPROXY_KEY=4ac5d314cc578f0216d080c03b2bc517a7e4226af8a4ed6a5617cf94e44c554c
IMGPROXY_SALT=00325181fcb6c7a7ef94ba22eab86f3115ddfaf7178dcba96d19a327c0ab65f1

# These next two LOOK symmetrical and are NOT. Getting it wrong shipped a P0 on
# 2026-09-05 where every campaign cover image on the live public site was broken
# -- and it went unnoticed because it tests fine from the server itself, where
# "localhost" happens to resolve to the right thing.
#
#   IMGPROXY_BASE_URL is the origin the VISITOR'S BROWSER fetches.
#     In any deployed environment this must be a PUBLIC HTTPS origin.
#     http://localhost:8090 resolves to the visitor's OWN machine, and plain
#     http:// on an https:// page is blocked as mixed content regardless.
#     Production does this without a second subdomain or certificate by
#     proxying imgproxy under the API host:
#       nginx:  location /img/ { proxy_pass http://127.0.0.1:8090/; }
#       env:    IMGPROXY_BASE_URL=https://api.<domain>/img
#     The trailing slash on proxy_pass is load-bearing -- it strips the /img
#     prefix so imgproxy receives exactly the path that was signed. Without it,
#     every request fails signature verification.
#
#   MEDIA_SOURCE_BASE_URL is base64-encoded into the signed path and resolved by
#     IMGPROXY ITSELF, server-side. imgproxy runs network_mode: host, so
#     localhost:9000 (MinIO) is correct here and must NOT be changed to a public
#     URL -- doing so would send imgproxy back out through the internet to fetch
#     an object sitting next to it, and expose the media bucket publicly.
IMGPROXY_BASE_URL=http://localhost:8090
MEDIA_SOURCE_BASE_URL=http://localhost:9000/campaign-media
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY_ID=fundforindonesia
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_BUCKET=campaign-media
MEDIA_S3_PRIVATE_BUCKET=campaign-documents
